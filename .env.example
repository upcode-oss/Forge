# Generate two different values with: openssl rand -hex 32
FORGE_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
FORGE_SETUP_TOKEN=CHANGE_ME_GENERATE_ANOTHER_RANDOM_VALUE
# Keep FORGE_SECRET_KEY unchanged after setup; it encrypts stored database and SMTP credentials.
FORGE_PUBLIC_URL=http://localhost:3000
FORGE_BIND_ADDRESS=127.0.0.1
FORGE_PORT=3000
FORGE_COOKIE_SECURE=false
FORGE_MAX_GIT_BODY_MB=100

# SSH Git access. Empty SSH host uses the hostname from the instance's public URL.
FORGE_SSH_ENABLED=true
FORGE_SSH_HOST=
FORGE_SSH_PORT=2222
FORGE_SSH_BIND_ADDRESS=127.0.0.1

# Optional database profiles. Replace passwords before enabling the profile.
POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
MARIADB_DATABASE=forge
MARIADB_USER=forge
MARIADB_PASSWORD=CHANGE_ME_MARIADB_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT_PASSWORD
